<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- A Developer ID build: the app and every helper inside it.

         V8 compiles JavaScript as it runs, in the main process and in every
         renderer, and the hardened runtime refuses that without this. It is the
         only exception Electron asks for, and the only one this file grants.
         Every other exception would be one more way into a signed process; see
         the entitlements note in forge.config.ts. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
