{
  "name": "statusky",
  "productName": "Statusky",
  "version": "0.1.0",
  "description": "A menu bar feed of AT Protocol infrastructure status updates.",
  "author": "statusky",
  "license": "MIT",
  "private": true,
  "repository": "github:cutenode/statusky",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/generate-ipc.mjs development",
    "dev": "electron-vite dev",
    "prestart": "node scripts/generate-ipc.mjs development",
    "start": "electron-vite preview",
    "prebuild": "node scripts/generate-ipc.mjs production",
    "build": "npm run check && electron-vite build",
    "precheck": "node scripts/generate-ipc.mjs production",
    "check": "npm run check:types && npm run lint",
    "check:types": "svelte-check --tsconfig ./tsconfig.web.json --threshold warning && tsc -p tsconfig.node.json --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "node scripts/generate-ipc.mjs production",
    "test": "vitest run",
    "pretest:watch": "node scripts/generate-ipc.mjs production",
    "test:watch": "vitest",
    "pretest:coverage": "node scripts/generate-ipc.mjs production",
    "test:coverage": "vitest run --coverage",
    "pretest:node": "node scripts/generate-ipc.mjs production",
    "test:node": "vitest run --project node --project node-development",
    "pretest:renderer": "node scripts/generate-ipc.mjs production",
    "test:renderer": "vitest run --project renderer",
    "icons": "node scripts/gen-icons.mjs",
    "package": "npm run build && electron-forge package",
    "dist": "npm run build && electron-forge make",
    "dist:mac": "npm run build && electron-forge make --platform=darwin",
    "dist:win": "npm run build && electron-forge make --platform=win32",
    "dist:linux": "npm run build && electron-forge make --platform=linux",
    "publish": "npm run build && electron-forge publish",
    "fixture": "esbuild scripts/gen-fixture.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/gen-fixture.mjs --log-level=error && node node_modules/.cache/gen-fixture.mjs",
    "generate:ipc": "node scripts/generate-ipc.mjs"
  },
  "dependencies": {
    "electron-store": "11.0.2",
    "update-electron-app": "3.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@lucide/svelte": "1.43.0",
    "@marshallofsound/ipc": "^2.7.1",
    "@reforged/maker-appimage": "5.3.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.5.0",
    "@vitest/coverage-v8": "4.1.11",
    "bits-ui": "2.19.1",
    "clsx": "2.1.1",
    "electron": "44.3.0",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "mode-watcher": "1.1.0",
    "oxlint": "1.82.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.57.0",
    "svelte-check": "4.7.6",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
