{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn",
    "pedantic": "off"
  },
  "env": {
    "browser": true,
    "es2024": true,
    "node": true
  },
  "ignorePatterns": [
    "out/**",
    "dist/**",
    "release/**",
    "node_modules/**",
    "coverage/**",
    "resources/**",
    "build/**",
    "src/renderer/src/lib/components/ui/**",
    "src/ipc/**",
    "src/ipc-development/**"
  ],
  "rules": {
    "no-console": "off",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/no-null": "off",
    "typescript/consistent-type-imports": "error",
    "typescript/no-explicit-any": "warn",
    "eqeqeq": ["error", "smart"],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@testing-library/svelte/vitest", "@ipc/preload/*"]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.test.ts", "src/test/**"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["**/*.d.ts"],
      "rules": {
        "unicorn/require-module-specifiers": "off"
      }
    }
  ]
}
